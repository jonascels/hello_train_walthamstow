# Copy to .env and fill in. .env is git-ignored; the key never reaches the browser.
TFL_APP_KEY=
LINE_ID=weaver
POLL_INTERVAL_S=30
# Two adjacent bridges on the Weaver line, Walthamstow (WGS84 lat/lon)
# Both are drawn on the map; one countdown per direction, timed at TIMING_BRIDGE_ID
TIMING_BRIDGE_ID=west-ave
BRIDGES='[{"id": "west-ave", "name": "West Ave", "lat": 51.583355, "lon": -0.015871}, {"id": "east-ave", "name": "East Ave", "lat": 51.583491, "lon": -0.014558}]'
